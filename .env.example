# ---- Stripe ----
# Stripe Dashboard > Developers > API keys (test için sk_test_... ile başlayın)
STRIPE_SECRET_KEY=

# (Opsiyonel) Dashboard'da oluşturduğunuz abonelik fiyatının ID'si (price_...)
# Boş bırakılırsa ₺79 tek seferlik ödeme olarak inline oluşturulur.
STRIPE_PRICE_ID=

# Stripe Dashboard > Webhooks > /api/stripe-webhook endpoint'inin imza anahtarı (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Sitenizin tam adresi (domain aldıktan sonra güncelleyin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
